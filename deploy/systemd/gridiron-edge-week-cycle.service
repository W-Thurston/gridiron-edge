[Unit]
Description=Run the Gridiron Edge weekly cycle (close the week, forecast, watch the starters)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/thursty/workspace/github.com/w-thurston/gridiron-edge
ExecStart=/home/thursty/.local/bin/uv run --no-sync gridiron week-cycle
TimeoutStartSec=2h
Nice=5
